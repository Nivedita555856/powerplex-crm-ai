  "_readme": {
    "env_vars_required": {
      "POWERPLEX_BACKEND_URL": "Your ngrok or Render URL, e.g. https://abc123.ngrok-free.app",
      "SLACK_WEBHOOK_URL": "Slack Incoming Webhook URL (Settings > Integrations > Incoming Webhooks)",
      "MANAGER_EMAIL": "Email address to receive daily reports"
    },
    "webhook_paths": {
      "inbound_query": "POST  <n8n-url>/webhook/powerplex-query    \u2014 send any CRM query, get AI answer back",
      "inbound_ticket": "POST  <n8n-url>/webhook/powerplex-tickets   \u2014 PowerPlex fires this on ticket creation"
    },
    "flows": {
      "Flow 1 \u2014 AI Chat Query": "Webhook \u2192 Prepare Payload \u2192 Call PowerPlex AI \u2192 Route by Intent \u2192 Respond",
      "Flow 2 \u2014 Ticket Alert": "Ticket Webhook \u2192 Is Critical? \u2192 Format \u2192 Send Slack",
      "Flow 3 \u2014 Daily Report": "9am Scheduler \u2192 Fetch Overview + Delay Analysis \u2192 Email Manager"
    },
    "how_to_import": [
      "1. Open n8n (cloud or self-hosted)",
      "2. Click '+ New Workflow' \u2192 '...' menu \u2192 'Import from file'",
      "3. Select this file: n8n_workflow.json",
      "4. Set environment variables: POWERPLEX_BACKEND_URL, SLACK_WEBHOOK_URL, MANAGER_EMAIL",
      "5. Run ngrok: ngrok http 8000  \u2014 copy the https URL into POWERPLEX_BACKEND_URL",
      "6. Copy each Webhook node's URL and paste into your .env: N8N_WEBHOOK_URL=<tickets webhook URL>",
      "7. Activate the workflow"
    ]
  }
}